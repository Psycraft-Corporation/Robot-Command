<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RobotCommand.Sdk</RootNamespace>
    <AssemblyName>RobotCommand.Sdk</AssemblyName>
    <PackageId>RobotCommand.Sdk</PackageId>
    <Version>0.1.0-alpha.3</Version>
    <Authors>Psycraft</Authors>
    <Description>Read-only .NET SDK for observing Robot Command over a trusted LAN.</Description>
    <PackageTags>logos;robot-command;grpc;observer</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto/team/v1/team.proto" GrpcServices="Both" />
    <None Include="Proto/team/v1/team.proto" Pack="true" PackagePath="contentFiles/any/any/protos/psycraft/logos/robotcommand/team/v1/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
