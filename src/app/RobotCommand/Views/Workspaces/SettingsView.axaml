<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             x:Class="RobotCommand.Views.Workspaces.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="720">
      <StackPanel Spacing="4">
        <TextBlock Classes="workspaceTitle" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Description}" />
      </StackPanel>

      <Border Classes="panel">
        <ToggleSwitch IsChecked="{Binding BrightModeEnabled}">
          <TextBlock FontWeight="SemiBold" Text="{Binding BrightModeTitle}" />
        </ToggleSwitch>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="sectionTitle" Text="{Binding LanguageTitle}" />
          <TextBlock Classes="muted" Text="{Binding LanguageDescription}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Languages}"
                    SelectedIndex="{Binding SelectedLanguageIndex, Mode=OneWay}"
                    DropDownClosed="OnLanguageDropDownClosed">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="sectionTitle" Text="{Binding UnitsTitle}" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
            <TextBlock Text="{Binding HorizontalDistanceTitle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Tag="horizontal" ItemsSource="{Binding HorizontalDistanceOptions}" SelectedIndex="{Binding HorizontalDistanceIndex, Mode=OneWay}" DropDownClosed="OnUnitDropDownClosed">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="{Binding VerticalDistanceTitle}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" Tag="vertical" ItemsSource="{Binding VerticalDistanceOptions}" SelectedIndex="{Binding VerticalDistanceIndex, Mode=OneWay}" DropDownClosed="OnUnitDropDownClosed">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Text="{Binding AreaTitle}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" Tag="area" ItemsSource="{Binding AreaOptions}" SelectedIndex="{Binding AreaIndex, Mode=OneWay}" DropDownClosed="OnUnitDropDownClosed">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="{Binding SpeedTitle}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" Tag="speed" ItemsSource="{Binding SpeedOptions}" SelectedIndex="{Binding SpeedIndex, Mode=OneWay}" DropDownClosed="OnUnitDropDownClosed">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="4" Text="{Binding TemperatureTitle}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1" Tag="temperature" ItemsSource="{Binding TemperatureOptions}" SelectedIndex="{Binding TemperatureIndex, Mode=OneWay}" DropDownClosed="OnUnitDropDownClosed">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
