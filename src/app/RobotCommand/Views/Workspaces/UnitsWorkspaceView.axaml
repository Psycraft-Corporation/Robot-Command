<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             x:Class="RobotCommand.Views.Workspaces.UnitsWorkspaceView"
             x:DataType="vm:UnitsWorkspaceViewModel">
  <TabControl ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
    <TabControl.ItemTemplate>
      <DataTemplate x:DataType="vm:UnitsWorkspaceSection">
        <TextBlock Text="{Binding Title}" />
      </DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate x:DataType="vm:UnitsWorkspaceSection">
        <ContentControl Content="{Binding Content}" />
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</UserControl>
