<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             x:Class="RobotCommand.Views.Workspaces.EventsView"
             x:DataType="vm:EventsViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="14">
    <StackPanel>
      <TextBlock Classes="workspaceTitle" Text="Events" />
      <TextBlock Classes="muted" Text="A unified live Logos operational event stream across every open connection." />
    </StackPanel>

    <Border Grid.Row="1" Classes="panel">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="sectionTitle" Text="Event stream" />
          <TextBlock Grid.Column="1" Classes="countBadge" Text="{Binding Count}" />
        </Grid>
        <Grid Grid.Row="1">
          <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6" ColumnDefinitions="105,90,100,100,*,130" ColumnSpacing="10">
                  <TextBlock Classes="muted" Text="{Binding Timestamp}" />
                  <TextBlock Grid.Column="1" Text="{Binding Severity}" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Domain}" />
                  <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Kind}" />
                  <TextBlock Grid.Column="4" TextWrapping="Wrap" Text="{Binding Message}" />
                  <StackPanel Grid.Column="5">
                    <TextBlock Classes="muted" Text="{Binding Source}" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding ConnectionId}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel IsVisible="{Binding IsEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="No events received" />
            <TextBlock Classes="muted" Text="Connect to a Logos runtime to start its event subscription." />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
