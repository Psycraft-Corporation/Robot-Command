<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             xmlns:models="using:RobotCommand.Models"
             x:Class="RobotCommand.Views.Workspaces.EvidenceLibraryView"
             x:DataType="vm:EvidenceLibraryViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Classes="workspaceTitle" Text="Evidence" />
        <TextBlock Classes="muted"
                   Text="Displayed frames and explicitly exported video clips stored locally for offline review." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="toolbarButton" Content="Open folder" Command="{Binding RevealCommand}" />
        <Button Classes="toolbarButton" Content="Refresh" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="14">
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Classes="sectionTitle" Text="Evidence library" />
              <TextBlock Classes="muted" FontSize="10" Text="{Binding StorageText}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="countBadge" Text="{Binding Count}" />
          </Grid>

          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEvidence}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:EvidenceRecord">
                  <Grid Margin="5" ColumnDefinitions="100,*,110,110" ColumnSpacing="10">
                    <TextBlock Text="{Binding Kind}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding FileName}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding SizeBytes}" />
                    <TextBlock Grid.Column="3" Classes="muted" Text="{Binding CreatedAt}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="No evidence exported" />
              <TextBlock Classes="muted"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="440"
                         Text="Use Capture displayed frame or Export selected clip in the Operate workspace." />
            </StackPanel>
          </Grid>

          <TextBlock Grid.Row="2" Classes="muted" FontSize="10" Text="{Binding StatusMessage}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="sectionTitle" Text="Selected evidence" />
          <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedTitle}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedSummary}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding SelectedContext}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="toolbarButton" Content="Open location" Command="{Binding RevealSelectedCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
          </StackPanel>
          <Border Classes="commandPlanPanel">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Evidence semantics" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Displayed-frame captures preserve exactly what Robot Command decoded. Source-camera still images remain a separate Logos operation and are never silently substituted by screenshots." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
