<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             x:Class="RobotCommand.Views.Workspaces.UnitsStubView"
             x:DataType="vm:UnitsStubViewModel">
  <Border Classes="panel" Padding="16">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
  </Border>
</UserControl>
