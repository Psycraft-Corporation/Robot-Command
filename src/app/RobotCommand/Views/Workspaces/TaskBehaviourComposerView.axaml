<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             xmlns:models="using:RobotCommand.Models"
             x:Class="RobotCommand.Views.Workspaces.TaskBehaviourComposerView"
             x:DataType="vm:TaskBehaviourComposerViewModel">
  <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="12">
    <Border Classes="noticePanel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="workspaceTitle" Text="Task behaviour" />
          <TextBlock Classes="muted"
                     Text="Compose the selected local task draft from one exact installed behaviour version, its declared parameters, and its resolved geometry bindings."
                     TextWrapping="Wrap" />
          <TextBlock FontWeight="SemiBold" Text="{Binding TaskSummary}" />
          <TextBlock Classes="muted" Text="{Binding TargetSummary}" />
        </StackPanel>
        <Button Grid.Column="1"
                VerticalAlignment="Center"
                Classes="primary"
                Command="{Binding RefreshCommand}"
                Content="Load compatible behaviours" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <StackPanel>
            <TextBlock Classes="sectionTitle" Text="Installed behaviours" />
            <TextBlock Classes="muted" Text="{Binding InventorySummary}" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1"
                  Padding="8"
                  CornerRadius="5"
                  Background="#1A2027"
                  BorderBrush="#3B414A"
                  BorderThickness="1">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
          </Border>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Behaviours}"
                   SelectedItem="{Binding SelectedBehaviour}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:TaskBehaviourChoice">
                <Border Margin="0,3" Padding="9" CornerRadius="5" BorderBrush="#3B414A" BorderThickness="1">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Ready, StringFormat='Ready: {0}'}" />
                    </Grid>
                    <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{Binding BehaviourSummary}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding BindingSummary}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel>
                <TextBlock Classes="sectionTitle" Text="Behaviour parameters" />
                <TextBlock Classes="muted" Text="{Binding Parameters.SchemaSummary}" TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox Grid.Column="1"
                        VerticalAlignment="Top"
                        IsEnabled="{Binding Parameters.HasUsableSchema}"
                        IsChecked="{Binding Parameters.UseRawJson, Mode=TwoWay}"
                        Content="Raw JSON" />
              <Button Grid.Column="2"
                      VerticalAlignment="Top"
                      Command="{Binding ResetParametersCommand}"
                      Content="Reset" />
            </Grid>

            <ItemsControl IsVisible="{Binding Parameters.ShowTypedFields}"
                          ItemsSource="{Binding Parameters.Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BehaviourParameterFieldViewModel">
                  <Border Margin="0,3" Padding="9" CornerRadius="5" Background="#1A2027" BorderBrush="#3B414A" BorderThickness="1">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding RequirementLabel}" />
                      </Grid>
                      <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                      <TextBox IsVisible="{Binding IsText}" Text="{Binding TextValue, Mode=TwoWay}" />
                      <TextBox IsVisible="{Binding IsMultiline}"
                               Text="{Binding TextValue, Mode=TwoWay}"
                               AcceptsReturn="True"
                               MinHeight="72"
                               TextWrapping="Wrap" />
                      <Grid IsVisible="{Binding IsNumeric}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding TextValue, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" Text="{Binding Unit}" />
                      </Grid>
                      <CheckBox IsVisible="{Binding IsBoolean}"
                                IsThreeState="True"
                                IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                Content="Enabled" />
                      <ComboBox IsVisible="{Binding IsEnum}"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding SelectedOptionItem, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="models:BehaviourParameterOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Classes="muted" Text="{Binding ConstraintSummary}" />
                      <TextBlock IsVisible="{Binding HasValidationMessage}"
                                 Classes="errorText"
                                 Text="{Binding ValidationMessage}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox IsVisible="{Binding Parameters.ShowRawEditor}"
                     Text="{Binding Parameters.RawJson, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     MinHeight="180"
                     PlaceholderText="{}" />

            <TextBlock Classes="muted" Text="{Binding Parameters.ValidationSummary}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding Parameters.HasIssues}" ItemsSource="{Binding Parameters.Issues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="errorText" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="primary"
                    HorizontalAlignment="Left"
                    Command="{Binding ApplyCommand}"
                    Content="Apply to local task draft"
                    Padding="14,8" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
