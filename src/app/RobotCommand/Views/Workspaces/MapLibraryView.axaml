<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotCommand.ViewModels"
             x:Class="RobotCommand.Views.Workspaces.MapLibraryView"
             x:DataType="vm:MapLibraryViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock Classes="workspaceTitle" Text="Offline Map Library" />
        <TextBlock Classes="muted"
                   Text="Install, validate, activate, and remove local Logos map packages." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Classes="smallPill">
          <TextBlock Text="{Binding ActivePackageText}" />
        </Border>
        <Border Classes="smallPill">
          <TextBlock Text="{Binding TotalStorageText}" />
        </Border>
        <Border Classes="smallPill">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding SavedViewCount}" />
            <TextBlock Text="saved view(s)" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="sectionTitle" Text="Installed packages" />
              <TextBlock Classes="muted" Text="{Binding LibraryPath}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="toolbarButton"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />
          </Grid>

          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Packages}"
                     SelectedItem="{Binding SelectedPackage}"
                     Classes="compactList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <Border Grid.Column="1" Classes="smallPill">
                      <TextBlock FontSize="10" Text="{Binding StateLabel}" />
                    </Border>
                    <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Kind}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{Binding ZoomSummary}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               Classes="muted"
                               Text="{Binding CoverageSummary}"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="emptyState"
                       IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="No offline map packages are installed." />
          </Grid>

          <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Classes="eyebrow" Text="IMPORT LOCAL PACKAGE" />
            <TextBox PlaceholderText="Directory or .zip path" Text="{Binding ImportPath}" />
            <Button Classes="primary"
                    HorizontalAlignment="Stretch"
                    Content="Import and validate"
                    Command="{Binding ImportCommand}" />
          </StackPanel>

          <Border Grid.Row="3" Classes="noticePanel">
            <StackPanel Spacing="6">
              <TextBlock Classes="eyebrow" Text="FIELD DEPLOYMENT BUNDLE" />
              <TextBox PlaceholderText="Deployment name" Text="{Binding DeploymentName}" />
              <TextBox PlaceholderText="Bundle .zip path" Text="{Binding DeploymentPath}" />
              <TextBox AcceptsReturn="True"
                       MinHeight="48"
                       PlaceholderText="Optional mission/task JSON paths; separate with semicolons or lines"
                       Text="{Binding DeploymentDocuments}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Classes="toolbarButton"
                        Content="Import bundle"
                        Command="{Binding ImportDeploymentCommand}" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Content="Export selected"
                        Command="{Binding ExportDeploymentCommand}" />
              </Grid>
              <TextBlock Classes="muted"
                         FontSize="9"
                         TextWrapping="Wrap"
                         Text="Exports the selected map package, all saved views, and optional local mission/task documents. No network service is used." />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedPackageTitle}" />
              <TextBlock Classes="muted" Text="{Binding SelectedPackageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="toolbarButton"
                      Content="Open directory"
                      Command="{Binding RevealCommand}" />
              <Button Classes="primary"
                      Content="Activate"
                      Command="{Binding ActivateCommand}" />
              <Button Classes="danger"
                      Content="Remove"
                      Command="{Binding RemoveCommand}" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Classes="noticePanel">
            <TextBlock Text="{Binding SelectedValidationDetails}" TextWrapping="Wrap" />
          </Border>

          <ScrollViewer Grid.Row="2">
            <TextBlock FontFamily="Consolas, Menlo, monospace"
                       Text="{Binding SelectedPackageDetails}"
                       TextWrapping="Wrap" />
          </ScrollViewer>

          <Border Grid.Row="3" Classes="surfaceFooter">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
